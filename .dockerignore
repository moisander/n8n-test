# Blacklist approach: include everything, exclude what Docker builds don't need.
# This supports the multi-stage Dockerfile that can build from source.

# VCS
.git

# Installed dependencies (reinstalled inside Docker)
**/node_modules

# Build caches
**/.turbo

# Test and coverage artifacts
**/coverage
**/.nyc_output

# IDE and editor files
.vscode
.idea
.cursor
**/*.swp
**/*.swo

# Development containers
.devcontainer

# Environment and secrets
.env
.env.*

# Build manifests (regenerated during build)
docker-build-manifest.json
